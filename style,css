/* ================================
   GLOBAL STYLES
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #070b14;
    --sidebar: #0b1120;
    --card: #111827;
    --card-hover: #172033;
    --border: #1f2937;

    --primary: #3b82f6;
    --purple: #8b5cf6;

    --green: #22c55e;
    --red: #ef4444;

    --text: #f8fafc;
    --text-secondary: #94a3b8;
    --muted: #64748b;

    --radius: 14px;
}

body {
    font-family: "Inter", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}


/* ================================
   LAYOUT
================================ */

.app {
    display: flex;
    min-height: 100vh;
}

.main {
    flex: 1;
    margin-left: 240px;
    padding: 28px;
    min-width: 0;
}


/* ================================
   SIDEBAR
================================ */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 240px;
    height: 100vh;

    background: var(--sidebar);
    border-right: 1px solid var(--border);

    padding: 25px 16px;

    display: flex;
    flex-direction: column;

    z-index: 100;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 21px;
    font-weight: 700;

    margin-bottom: 35px;
}

.logo-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(
        135deg,
        var(--primary),
        var(--purple)
    );

    border-radius: 10px;

    font-size: 20px;
}

.nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 14px;

    color: var(--text-secondary);
    text-decoration: none;

    border-radius: 10px;

    transition: 0.25s ease;
}

.nav-item:hover {
    background: rgba(59, 130, 246, 0.1);
    color: white;
}

.nav-item.active {
    background: linear-gradient(
        90deg,
        rgba(59, 130, 246, 0.2),
        rgba(139, 92, 246, 0.12)
    );

    color: white;
    border-left: 3px solid var(--primary);
}


/* ================================
   HEADER
================================ */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 30px;
}

.header-left h1 {
    font-size: 28px;
    margin-bottom: 8px;
}

.header-left p {
    color: var(--text-secondary);
    font-size: 14px;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 14px;
}


/* ================================
   SEARCH
================================ */

.search-box {
    display: flex;
    align-items: center;
    gap: 10px;

    width: 240px;

    background: var(--card);
    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 10px 14px;
}

.search-box input {
    width: 100%;

    background: transparent;
    border: none;
    outline: none;

    color: white;
}

.search-box input::placeholder {
    color: var(--muted);
}


/* ================================
   BUTTONS
================================ */

.btn {
    border: none;
    outline: none;

    padding: 11px 17px;

    border-radius: 10px;

    color: white;
    font-weight: 600;

    cursor: pointer;

    transition: 0.25s ease;
}

.btn-primary {
    background: linear-gradient(
        135deg,
        var(--primary),
        var(--purple)
    );
}

.btn-primary:hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 25px rgba(59, 130, 246, 0.25);
}

.btn-secondary {
    background: var(--card);
    border: 1px solid var(--border);
}

.btn-secondary:hover {
    background: var(--card-hover);
}


/* ================================
   LIVE STATUS
================================ */

.live-status {
    display: flex;
    align-items: center;
    gap: 7px;

    color: var(--green);

    font-size: 13px;
}

.live-dot {
    width: 8px;
    height: 8px;

    background: var(--green);

    border-radius: 50%;

    box-shadow:
        0 0 10px var(--green);
}


/* ================================
   STAT CARDS
================================ */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 25px;
}

.stat-card {
    background:
        linear-gradient(
            145deg,
            rgba(17, 24, 39, 0.95),
            rgba(11, 17, 32, 0.95)
        );

    border: 1px solid var(--border);

    border-radius: var(--radius);

    padding: 20px;

    transition: 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-4px);

    border-color: rgba(
        59,
        130,
        246,
        0.45
    );

    background: var(--card-hover);
}

.stat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 15px;
}

.stat-title {
    color: var(--text-secondary);
    font-size: 13px;
}

.stat-icon {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: rgba(59, 130, 246, 0.12);

    color: var(--primary);
}

.stat-value {
    font-size: 25px;
    font-weight: 700;

    margin-bottom: 8px;
}

.change {
    font-size: 13px;
    font-weight: 600;
}

.positive {
    color: var(--green);
}

.negative {
    color: var(--red);
}


/* ================================
   CARDS
================================ */

.card {
    background: var(--card);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    padding: 22px;

    margin-bottom: 24px;
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 20px;
}

.card-title {
    font-size: 18px;
    font-weight: 600;
}

.card-subtitle {
    color: var(--text-secondary);
    font-size: 13px;
    margin-top: 4px;
}


/* ================================
   CRYPTO TABLE
================================ */

.table-container {
    width: 100%;
    overflow-x: auto;
}

.crypto-table {
    width: 100%;

    border-collapse: collapse;

    min-width: 850px;
}

.crypto-table th {
    color: var(--muted);

    font-size: 12px;
    font-weight: 500;

    text-align: left;

    padding: 13px;

    border-bottom: 1px solid var(--border);
}

.crypto-table td {
    padding: 16px 13px;

    border-bottom: 1px solid
        rgba(31, 41, 55, 0.7);

    font-size: 14px;
}

.crypto-table tbody tr {
    transition: 0.2s ease;
}

.crypto-table tbody tr:hover {
    background: rgba(
        59,
        130,
        246,
        0.05
    );
}

.coin {
    display: flex;
    align-items: center;
    gap: 12px;
}

.coin-icon {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #1e293b;

    border-radius: 50%;

    font-weight: 700;
}

.coin-name {
    font-weight: 600;
}

.coin-symbol {
    color: var(--muted);

    font-size: 11px;

    margin-top: 3px;
}


/* ================================
   CHART
================================ */

.chart-card {
    min-height: 400px;
}

.chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
}

.chart-price {
    font-size: 26px;
    font-weight: 700;
}

.chart {
    width: 100%;
    height: 300px;

    position: relative;

    border-radius: 10px;

    background:
        linear-gradient(
            to bottom,
            rgba(59, 130, 246, 0.05),
            transparent
        );
}

.chart-line {
    width: 100%;
    height: 100%;
}

.time-buttons {
    display: flex;
    gap: 6px;
}

.time-btn {
    background: transparent;

    border: 1px solid var(--border);

    color: var(--text-secondary);

    padding: 7px 12px;

    border-radius: 7px;

    cursor: pointer;
}

.time-btn:hover,
.time-btn.active {
    background: var(--primary);

    color: white;

    border-color: var(--primary);
}


/* ================================
   GAINERS / LOSERS
================================ */

.two-column {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 20px;
}

.coin-list {
    display: flex;
    flex-direction: column;

    gap: 14px;
}

.coin-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 10px;

    border-radius: 10px;

    transition: 0.2s ease;
}

.coin-row:hover {
    background: rgba(
        255,
        255,
        255,
        0.03
    );
}

.coin-info {
    display: flex;
    align-items: center;
    gap: 10px;
}


/* ================================
   WATCHLIST
================================ */

.watchlist {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 12px;
}

.watch-item {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 14px;

    background: #0d1524;

    border: 1px solid var(--border);

    border-radius: 10px;
}

.favorite {
    color: #fbbf24;

    cursor: pointer;
}


/* ================================
   STATUS CARD
================================ */

.status-grid {
    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 12px;
}

.status-item {
    padding: 15px;

    background: #0d1524;

    border-radius: 10px;

    border: 1px solid var(--border);
}

.status-label {
    color: var(--text-secondary);

    font-size: 12px;

    margin-bottom: 8px;
}

.status-value {
    font-weight: 600;
}

.status-online {
    color: var(--green);
}


/* ================================
   FOOTER
================================ */

.footer {
    border-top: 1px solid var(--border);

    margin-top: 40px;

    padding: 25px 0;

    color: var(--text-secondary);

    font-size: 13px;

    text-align: center;
}


/* ================================
   MOBILE MENU
================================ */

.mobile-menu {
    display: none;

    width: 40px;
    height: 40px;

    background: var(--card);

    border: 1px solid var(--border);

    color: white;

    border-radius: 8px;

    cursor: pointer;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 1200px) {

    .stats-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .status-grid {
        grid-template-columns:
            repeat(3, 1fr);
    }
}


@media (max-width: 900px) {

    .sidebar {
        transform: translateX(-100%);
        transition: 0.3s ease;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
        padding: 20px;
    }

    .mobile-menu {
        display: block;
    }

    .header {
        gap: 15px;
    }

    .header-right {
        flex-wrap: wrap;
    }

    .two-column {
        grid-template-columns: 1fr;
    }

    .watchlist {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 600px) {

    .main {
        padding: 15px;
    }

    .header {
        align-items: flex-start;
    }

    .header-left h1 {
        font-size: 22px;
    }

    .header-right {
        display: none;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .status-grid {
        grid-template-columns: 1fr;
    }

    .card {
        padding: 16px;
    }

    .chart-card {
        min-height: 350px;
    }

    .time-buttons {
        overflow-x: auto;
    }

    .time-btn {
        white-space: nowrap;
    }
}


/* ================================
   SCROLLBAR
================================ */

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: var(--bg);
}

::-webkit-scrollbar-thumb {
    background: #263449;

    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: #3b4d68;
}
