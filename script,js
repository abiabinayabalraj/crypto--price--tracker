    /* ==========================================
       FORMAT CURRENCY
    ========================================== */

    function formatPrice(price) {

        if (price < 1) {
            return "$" + price.toFixed(3);
        }

        return "$" + price.toLocaleString(
            "en-US",
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );
    }


    /* ==========================================
       CREATE CRYPTO TABLE
    ========================================== */

    function renderCryptoTable(data = cryptoData) {

        const tableBody =
            document.querySelector("#cryptoTableBody");

        if (!tableBody) return;

        tableBody.innerHTML = "";

        data.forEach((coin) => {

            const changeClass =
                coin.change24h >= 0
                    ? "positive"
                    : "negative";

            const changeSymbol =
                coin.change24h >= 0
                    ? "↑"
                    : "↓";

            const row = document.createElement("tr");

            row.innerHTML = `

                <td>
                    ${coin.rank}
                </td>

                <td>
                    <div class="coin">

                        <div class="coin-icon">
                            ${coin.icon}
                        </div>

                        <div>
