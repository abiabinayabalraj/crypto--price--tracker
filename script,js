    function renderWatchlist() {

        const container =
            document.querySelector(
                "#watchlist"
            );

        if (!container) return;

        container.innerHTML = "";

        watchlist.forEach(symbol => {

            const coin =
                cryptoData.find(
                    item =>
                        item.symbol === symbol
                );

            if (!coin) return;

            const div =
                document.createElement("div");

            div.className =
