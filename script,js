    /* ==========================================
       CSV EXPORT
    ========================================== */

    const exportButton =
        document.querySelector(
            "#exportCSV"
        );

    if (exportButton) {

        exportButton.addEventListener(
            "click",
            () => {

                let csv =
                    "Rank,Name,Symbol,Price,24h Change,7d Change,Market Cap,Volume\n";

                cryptoData.forEach(coin => {

                    csv +=
                        `${coin.rank},` +
                        `${coin.name},` +
                        `${coin.symbol},` +
                        `${coin.price},` +
                        `${coin.change24h}%,` +
                        `${coin.change7d}%,` +
                        `${coin.marketCap},` +
                        `${coin.volume}\n`;
                });


                const blob =
                    new Blob(
                        [csv],
                        {
                            type:
                                "text/csv"
                        }
                    );

                const url =
                    URL.createObjectURL(
                        blob
                    );

                const link =
                    document.createElement(
                        "a"
                    );

                link.href = url;

                link.download =
                    "crypto_data.csv";

                link.click();

                URL.revokeObjectURL(
                    url
                );
            }
        );
    }


    /* ==========================================
       INITIALIZE
    ========================================== */

    renderCryptoTable();

    renderWatchlist();

    updateChart("24H");

    updateTimestamp();

