                    </div>
                </div>

                <span
                    class="favorite"
                    data-symbol="${coin.symbol}">
                    ★
                </span>

            `;

            container.appendChild(div);
        });


        document
            .querySelectorAll(".favorite")
            .forEach(star => {

                star.addEventListener(
                    "click",
                    () => {

                        const symbol =
                            star.dataset.symbol;

                        watchlist =
                            watchlist.filter(
                                item =>
                                    item !== symbol
                            );

                        renderWatchlist();
                    }
                );
            });
    }


    /* ==========================================
       PRICE ALERTS
    ========================================== */

    const alertButton =
        document.querySelector(
            "#createAlert"
