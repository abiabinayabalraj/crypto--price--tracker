                    <button
                        class="btn btn-secondary view-coin"
                        data-symbol="${coin.symbol}">
                        View
                    </button>
                </td>

            `;

            tableBody.appendChild(row);
        });

        addViewButtons();
    }


    /* ==========================================
       VIEW COIN
    ========================================== */

    function addViewButtons() {

        const buttons =
            document.querySelectorAll(".view-coin");

        buttons.forEach(button => {

            button.addEventListener("click", () => {

                const symbol =
                    button.dataset.symbol;

                const coin =
                    cryptoData.find(
                        item => item.symbol === symbol
                    );

                if (!coin) return;

                alert(
                    `${coin.name} (${coin.symbol})\n\n` +
                    `Price: ${formatPrice(coin.price)}\n` +
                    `24h Change: ${coin.change24h}%\n` +
                    `7d Change: ${coin.change7d}%\n` +
                    `Market Cap: $${coin.marketCap}`
                );
            });
        });
    }


    /* ==========================================
       SEARCH CRYPTO
    ========================================== */

    const searchInput =
        document.querySelector("#cryptoSearch");

    if (searchInput) {

        searchInput.addEventListener(
            "input",
            (event) => {

                const query =
                    event.target.value
                        .toLowerCase()
                        .trim();

                const filtered =
                    cryptoData.filter(coin =>
                        coin.name
                            .toLowerCase()
                            .includes(query) ||

                        coin.symbol
                            .toLowerCase()
                            .includes(query)
                    );

                renderCryptoTable(filtered);
            }
        );
    }


    /* ==========================================
       SORT BY PRICE
    ========================================== */

    const sortPrice =
        document.querySelector("#sortPrice");

    if (sortPrice) {

        sortPrice.addEventListener(
            "change",
            (event) => {

                const value =
                    event.target.value;

                let sorted = [...cryptoData];

                if (value === "high") {

                    sorted.sort(
                        (a, b) =>
                            b.price - a.price
                    );

                }

                if (value === "low") {

                    sorted.sort(
                        (a, b) =>
                            a.price - b.price
                    );

                }

                if (value === "change") {

                    sorted.sort(
                        (a, b) =>
                            b.change24h -
                            a.change24h
                    );
                }

                renderCryptoTable(sorted);
            }
        );
    }


    /* ==========================================
       REFRESH DATA
    ========================================== */

    const refreshButton =
        document.querySelector(".btn-primary");

    if (refreshButton) {

        refreshButton.addEventListener(
            "click",
            () => {

                refreshButton.innerHTML =
                    "⟳ Updating...";

                refreshButton.disabled = true;

                setTimeout(() => {

                    simulatePriceUpdate();

                    renderCryptoTable();

                    refreshButton.innerHTML =
                        "↻ Refresh Data";

                    refreshButton.disabled = false;

                    updateTimestamp();

                }, 1000);
            }
        );
    }


    /* ==========================================
       SIMULATE PRICE UPDATE
    ========================================== */

    function simulatePriceUpdate() {

        cryptoData.forEach(coin => {

            const movement =
                (Math.random() - 0.5) * 0.02;

            coin.price =
                coin.price *
                (1 + movement);

        });
    }


    /* ==========================================
       UPDATE TIMESTAMP
    ========================================== */

    function updateTimestamp() {

        const element =
            document.querySelector(
                "#lastUpdated"
            );

        if (!element) return;

        const now =
            new Date();

        element.textContent =
            "Updated " +
            now.toLocaleTimeString();
    }


